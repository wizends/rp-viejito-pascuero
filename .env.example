# ─────────────────────────────────────────────────────────────
#  Buzón del Viejito Pascuero — variables de entorno
#  Copia este archivo a .env y ajusta. Docker Compose lo lee solo.
# ─────────────────────────────────────────────────────────────

# development | production | test. En production se exige SECRET_KEY fuerte y COOKIE_SECURE=true.
ENVIRONMENT=development

# Clave para firmar los JWT. Genera una con:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=solo-desarrollo-cambiar-en-produccion

# Contraseña de PostgreSQL (solo Docker)
POSTGRES_PASSWORD=pascuero

# Fuera de Docker se usa backend/buzon.db (SQLite). En Docker se sobrescribe con PostgreSQL.
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/buzon
REDIS_URL=redis://localhost:6379/0
# inline = BackgroundTasks (sin Redis) · rq = cola en Redis con worker separado
TASK_BACKEND=inline

# Orígenes permitidos (separados por coma). En Docker el frontend sirve /api por el mismo origen.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Cookies. En producción con HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Rate limiting (peticiones por ventana de RATE_LIMIT_WINDOW_SECONDS)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IP=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOADS=12

# Archivos y retención
MAX_UPLOAD_MB=10
# Borra la foto apenas la carta se lee (se conserva solo si necesita ayuda de un duende).
DELETE_IMAGES_AFTER_PROCESSING=true
# Toda imagen que siga guardada se borra a los N días.
RETENTION_DAYS=60

# ── OCR ──
# auto prueba easyocr → paddleocr → tesseract
OCR_ENGINE=auto
# Criterio de fallo: si no se cumple, se usa la IA de visión.
OCR_MIN_CONFIDENCE=0.60
OCR_MIN_VALID_WORDS=3
OCR_MAX_GARBAGE_RATIO=0.35

# ── IA de visión (fallback) ──
# trocr (local, por defecto, nada sale del servidor) | gemini | groq | openrouter | none
# Los externos solo se usan si el padre lo acepta en su panel; si no, se usa trocr.
VISION_PROVIDER=trocr
# La respuesta de la IA también debe pasar el criterio (palabras en español, sin basura) con esta confianza mínima.
VISION_MIN_CONFIDENCE=0.5
TROCR_MODEL=microsoft/trocr-base-handwritten
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# Docker: false para una imagen liviana sin EasyOCR/TrOCR (queda Tesseract)
INSTALL_ML=true

# ── Tracking ──
TIMEZONE=America/Santiago
AUTO_ADVANCE_INTERVAL_SECONDS=30

# ── Frontend (Vite) ──
# Teselas del mapa. Vacío = mapa ilustrado sin teselas (no se contacta a terceros).
VITE_MAP_TILES_URL=
