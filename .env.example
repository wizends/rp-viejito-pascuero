# ─────────────────────────────────────────────────────────────
#  Buzón del Viejito Pascuero — variables de entorno
#  Copia este archivo a .env y ajusta. Docker Compose lo lee solo.
# ─────────────────────────────────────────────────────────────

# development | production | test. En production se exige SECRET_KEY fuerte y COOKIE_SECURE=true.
ENVIRONMENT=development

# Clave para firmar las sesiones (JWT). Genera una con:  openssl rand -base64 48
SECRET_KEY=solo-desarrollo-cambiar-en-produccion

# Puerto del backend (Render, Railway y Fly.io lo definen solos)
PORT=8000
# Carpeta con la base SQLite (buzon.db) y las fotos de las cartas (uploads/). En Docker: /app/data
DATA_DIR=data

# Orígenes permitidos (separados por coma). También valida el origen de los WebSockets.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Cookies. En producción con HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Rate limiting (peticiones por ventana de RATE_LIMIT_WINDOW_SECONDS)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IP=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOADS=12
# true solo si el backend queda detrás de un proxy propio (frontend en Vercel) y no es accesible directo:
# la IP del cliente se toma de X-Forwarded-For para que el rate limit no agrupe a todos.
TRUST_FORWARDED_FOR=false

# Fotos de cartas: se guardan limpias (sin EXIF/GPS) y se borran a los N días (0 = nunca).
MAX_UPLOAD_MB=10
RETENTION_DAYS=60

# ── IA de visión (opcional) ──
# Sin OCR: la foto de una carta se guarda como imagen. Si configuras un proveedor con capa
# gratuita y el papá/mamá lo acepta en su panel, un modelo transcribe el texto y los regalos.
# none | gemini | groq | openrouter
VISION_PROVIDER=none
VISION_TIMEOUT_SECONDS=60
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OpenRouter (modelos ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# ── Tracking ──
TIMEZONE=America/Santiago
AUTO_ADVANCE_INTERVAL_SECONDS=30

# ── Frontend (Vite) ──
# Teselas del mapa. Vacío = mapa ilustrado sin teselas (no se contacta a terceros).
VITE_MAP_TILES_URL=
# Solo en Vercel (backend en otro dominio): origen de los WebSockets, p. ej. wss://api.tudominio.cl
VITE_WS_URL=
